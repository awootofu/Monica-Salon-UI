<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Shared.RoleSelectPage"
             Title="Pilih Peran"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Pilih peran" Style="{StaticResource Eyebrow}" />
            <Label Text="Bagaimana kamu memakai Monica?" Style="{StaticResource ScreenTitle}" />
            <Label Text="Pilih peran untuk melanjutkan ke pengalaman yang tepat."
                   Style="{StaticResource BodyCopy}" />

            <Border x:Name="CustomerCard" Style="{StaticResource CardFrame}" Stroke="{StaticResource DustyRose}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Customer" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Booking &amp; riwayat" Style="{StaticResource BodyCopy}" />
                    <Label Text="Simulasi rambut" Style="{StaticResource MutedCopy}" />
                    <Button Text="Pilih Customer" Style="{StaticResource SecondaryButton}" Clicked="OnSelectCustomer" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="OwnerCard" Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Owner / Admin" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Dashboard bisnis" Style="{StaticResource BodyCopy}" />
                    <Label Text="Kasir &amp; inventori" Style="{StaticResource MutedCopy}" />
                    <Button Text="Pilih Owner" Style="{StaticResource SecondaryButton}" Clicked="OnSelectOwner" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Lanjut" Style="{StaticResource PrimaryButton}" Clicked="OnContinue" />
            <Button Text="Kembali" Style="{StaticResource GhostButton}" Clicked="OnBack" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
