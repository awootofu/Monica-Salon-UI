<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Shared.AdminBottomNav"
             x:Name="Root">
    <Border BackgroundColor="White"
            Stroke="#E7DDD6"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18"
            Padding="8">
        <Grid ColumnDefinitions="*,*,*,*,*">
            <Button Grid.Column="0" Text="Dashboard" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnDashboardClicked" />
            <Button Grid.Column="1" Text="Bookings" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnBookingsClicked" />
            <Button Grid.Column="2" Text="Cashier" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnCashierClicked" />
            <Button Grid.Column="3" Text="Inventory" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnInventoryClicked" />
            <Button Grid.Column="4" Text="More" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnMoreClicked" />
        </Grid>
    </Border>
</ContentView>
