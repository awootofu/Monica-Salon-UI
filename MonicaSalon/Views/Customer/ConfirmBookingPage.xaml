<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Customer.ConfirmBookingPage"
             Title="Konfirmasi Booking"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Langkah 2 dari 3" Style="{StaticResource Eyebrow}" />
            <Label Text="Konfirmasi Booking" Style="{StaticResource ScreenTitle}" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="1 Waktu" Style="{StaticResource MutedCopy}" />
                <Label Text="/" Style="{StaticResource MutedCopy}" />
                <Label Text="2 Konfirmasi" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource DeepCocoa}" />
                <Label Text="/" Style="{StaticResource MutedCopy}" />
                <Label Text="3 Terkirim" Style="{StaticResource MutedCopy}" />
            </HorizontalStackLayout>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Layanan Dipilih" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="{Binding ServicesSummary}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="{Binding ServicesCountText}" Style="{StaticResource MutedCopy}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Detail Jadwal" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Tanggal" Style="{StaticResource MutedCopy}" />
                    <Label Text="{Binding BookingDateText}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Waktu" Style="{StaticResource MutedCopy}" />
                    <Label Text="{Binding BookingTimeText}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Referensi Gaya" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Image x:Name="HairstyleImage" Source="{Binding HairstyleImage}" WidthRequest="52" HeightRequest="52" Aspect="AspectFill" IsVisible="{Binding HasHairstyle}" />
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center" HorizontalOptions="Fill">
                            <Label x:Name="HairstyleName" Text="{Binding HairstyleName}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                            <Label x:Name="HairstyleNote" Text="{Binding HairstyleNote}" Style="{StaticResource MutedCopy}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                    <Button x:Name="ChangeStyleBtn" Text="Pilih / Ubah Gaya" Style="{StaticResource SecondaryButton}" FontSize="12" HeightRequest="46" Clicked="OnChangeStyle" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Kontak" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Bella Anisa" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="+62 812-3456-7890" Style="{StaticResource BodyCopy}" />
                    <Label Text="Catatan permintaan (opsional)" Style="{StaticResource MutedCopy}" />
                    <Editor x:Name="RequestEditor" Placeholder="Contoh: warna cokelat natural, kulit sensitif..." MaxLength="180" AutoSize="TextChanges" TextColor="{StaticResource Charcoal}" />
                    <Label Text="Maks 180 karakter" Style="{StaticResource MutedCopy}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Rincian Harga" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Services}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Name}" Style="{StaticResource BodyCopy}" />
                                    <Label Text="{Binding Price}" Style="{StaticResource BodyCopy}" Grid.Column="1" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Biaya layanan" Style="{StaticResource BodyCopy}" />
                        <Label Text="Rp 0" Style="{StaticResource BodyCopy}" Grid.Column="1" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E7DDD6" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Estimasi total" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                        <Label Text="{Binding ServicesTotalText}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Kebijakan Keterlambatan" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="• Terlambat 1–10 menit: booking tetap aktif, silakan tetap datang." Style="{StaticResource BodyCopy}" />
                    <Label Text="• Terlambat 10–15 menit: hubungi salon. Admin menentukan layanan masih bisa dilakukan atau perlu dijadwalkan ulang." Style="{StaticResource BodyCopy}" />
                    <Label Text="• Waktu layanan sudah tidak memungkinkan: admin menawarkan jadwal baru sesuai ketersediaan." Style="{StaticResource BodyCopy}" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Submit Booking" Style="{StaticResource PrimaryButton}" Clicked="OnSubmit" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
