<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Customer.LoginPage"
             Title="Login"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="← Kembali" Style="{StaticResource GhostButton}" Clicked="OnBack" HorizontalOptions="Start" />
            <Label Text="Welcome Back!" Style="{StaticResource Eyebrow}" />
            <Label Text="Saatnya kembali merawat dirimu." Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Email" Style="{StaticResource MutedCopy}" />
                    <Entry x:Name="EmailEntry" Placeholder="customer@email.com" Keyboard="Email" Text="{Binding Email}" TextColor="{StaticResource Charcoal}" PlaceholderColor="{StaticResource Muted}" />
                    <Label Text="Password" Style="{StaticResource MutedCopy}" />
                    <Entry x:Name="PasswordEntry" Placeholder="Minimal 6 karakter" IsPassword="True" Text="{Binding Password}" TextColor="{StaticResource Charcoal}" PlaceholderColor="{StaticResource Muted}" />
                    <Label x:Name="ErrorLabel" Text="{Binding ErrorMessage}" TextColor="{StaticResource DangerText}" FontSize="12" IsVisible="{Binding HasError}" />
                    <Button Text="Lupa password?" Style="{StaticResource GhostButton}" Clicked="OnForgot" HorizontalOptions="End" />
                    <Button Text="Masuk" Style="{StaticResource PrimaryButton}" Clicked="OnLogin" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Akun demo" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="customer@email.com masuk sebagai customer, owner@email.com masuk sebagai owner." Style="{StaticResource MutedCopy}" />
                </VerticalStackLayout>
            </Border>
            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="Belum punya akun?" Style="{StaticResource MutedCopy}" VerticalOptions="Center" />
                <Button Text="Daftar sekarang" Style="{StaticResource GhostButton}" Clicked="OnGoRegister" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
