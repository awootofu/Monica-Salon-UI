<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Customer.SchedulePage"
             Title="Pilih Jadwal"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Langkah 1 dari 3" Style="{StaticResource Eyebrow}" />
            <Label Text="Pilih Jadwal" Style="{StaticResource ScreenTitle}" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="1 Waktu" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource DeepCocoa}" />
                <Label Text="/" Style="{StaticResource MutedCopy}" />
                <Label Text="2 Konfirmasi" Style="{StaticResource MutedCopy}" />
                <Label Text="/" Style="{StaticResource MutedCopy}" />
                <Label Text="3 Terkirim" Style="{StaticResource MutedCopy}" />
            </HorizontalStackLayout>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Pilih Layanan" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Bisa pilih lebih dari 1, total dihitung otomatis."
                           Style="{StaticResource MutedCopy}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ServiceOptions}" Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <HorizontalStackLayout Spacing="10" Padding="0,6">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Color="{StaticResource DustyRose}"
                                              VerticalOptions="Center" />
                                    <VerticalStackLayout Spacing="0" VerticalOptions="Center" HorizontalOptions="Fill">
                                        <Label Text="{Binding Service.Name}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource DeepCocoa}" />
                                        <Label Text="{Binding Service.Price}" Style="{StaticResource MutedCopy}" FontSize="11" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#E7DDD6" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding ServicesCountText}" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Label Text="{Binding ServicesTotalText}" Grid.Column="1" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Referensi Gaya (Opsional)" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Pilih contoh gaya dari buku salon agar stylist paham keinginanmu."
                           Style="{StaticResource MutedCopy}" />
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Image x:Name="HairstyleThumb" Source="{Binding HairstyleImage}" WidthRequest="52" HeightRequest="52" Aspect="AspectFill" IsVisible="{Binding HasHairstyle}" />
                        <Label x:Name="HairstyleLabel" Text="{Binding HairstyleText}" Style="{StaticResource BodyCopy}" VerticalOptions="Center" HorizontalOptions="Fill" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Lihat Buku Gaya" Style="{StaticResource SecondaryButton}" FontSize="12" HeightRequest="46" Clicked="OnBrowseStyles" />
                        <Button Grid.Column="1" x:Name="ClearStyleBtn" Text="Hapus" Style="{StaticResource GhostButton}" Clicked="OnClearStyle" IsVisible="{Binding HasHairstyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Pilih Tanggal" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="{Binding MonthLabel}" Style="{StaticResource MutedCopy}" />
                    <Border Stroke="#D9CFC4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,4">
                        <DatePicker x:Name="DatePicker"
                                    Date="{Binding SelectedDate}"
                                    MinimumDate="{Binding MinDate}"
                                    MaximumDate="{Binding MaxDate}"
                                    DateSelected="OnDateSelected"
                                    FontSize="14"
                                    TextColor="{StaticResource DeepCocoa}"
                                    HeightRequest="48" />
                    </Border>
                    <Label Text="{Binding SelectedDateText}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Ketuk tanggal untuk membuka kalender." Style="{StaticResource MutedCopy}" FontSize="11" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Pilih Jam" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn0900" Text="09.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" />
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1000" Text="10.00 penuh" IsEnabled="False" WidthRequest="100" HeightRequest="44" FontSize="12" Margin="0,0,6,6" />
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1100" Text="11.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" />
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1300" Text="13.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" />
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1400" Text="14.00 penuh" IsEnabled="False" WidthRequest="100" HeightRequest="44" FontSize="12" Margin="0,0,6,6" />
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1530" Text="15.30" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" />
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1700" Text="17.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" />
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1800" Text="18.00 penuh" IsEnabled="False" WidthRequest="100" HeightRequest="44" FontSize="12" Margin="0,0,6,6" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
            <Label x:Name="SummaryLabel" Text="{Binding Summary}" Style="{StaticResource MutedCopy}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Kebijakan Keterlambatan" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="• Terlambat 1–10 menit: booking tetap aktif, silakan tetap datang." Style="{StaticResource BodyCopy}" />
                    <Label Text="• Terlambat 10–15 menit: hubungi salon. Admin menentukan layanan masih bisa dilakukan atau perlu dijadwalkan ulang." Style="{StaticResource BodyCopy}" />
                    <Label Text="• Waktu layanan sudah tidak memungkinkan: admin menawarkan jadwal baru sesuai ketersediaan." Style="{StaticResource BodyCopy}" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Lanjut" Style="{StaticResource PrimaryButton}" Clicked="OnContinue" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
