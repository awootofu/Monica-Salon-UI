<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Customer.WelcomePage"
             Title="Selamat Datang"
             BackgroundColor="{StaticResource Ivory}">
    <Grid RowDefinitions="*,*">
        <!-- Banner 1/2 layar -->
        <Grid>
            <Image Source="welcome.jpg" Aspect="AspectFill" />
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#66000000" Offset="0.0" />
                        <GradientStop Color="#CC5C332D" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>
            <VerticalStackLayout Padding="20,0,20,12" VerticalOptions="End" Spacing="2">
                <Label Text="MONICA SALON · INDONESIA" TextColor="White" FontSize="10" FontAttributes="Bold" Opacity="0.85" />
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Monica" TextColor="White" FontSize="22" FontAttributes="Bold" />
                    <Label Text="SALON" TextColor="White" FontSize="11" FontAttributes="Bold" VerticalOptions="End" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- Konten compact -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,14,20,20" Spacing="10">
                <Button Text="Get Started" Style="{StaticResource PrimaryButton}" Clicked="OnGetStarted" />
                <Button Text="Login" Style="{StaticResource SecondaryButton}" Clicked="OnLogin" />
                <Label Text="A little care, a lovely you." Style="{StaticResource MutedCopy}" FontSize="11" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
