<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Customer.SimulationIntroPage"
             Title="Bayangkan gaya barumu."
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali"
                    Style="{StaticResource GhostButton}"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />
            <Border StrokeShape="RoundRectangle 18"
                    Stroke="#E7DDD6"
                    StrokeThickness="1"
                    Padding="0"
                    BackgroundColor="White">
                <Image Source="welcome.jpg"
                       HeightRequest="300"
                       Aspect="AspectFill" />
            </Border>
            <Label Text="Visual consultation" Style="{StaticResource MutedCopy}" />
            <Label Text="Hair Simulation" Style="{StaticResource Eyebrow}" />
            <Label Text="Bayangkan gaya barumu." Style="{StaticResource ScreenTitle}" />
            <Label Text="Coba pratinjau gaya rambut sebelum konsultasi dengan stylist."
                   Style="{StaticResource BodyCopy}" />
            <Border Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="01" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource RoseDark}" VerticalOptions="Start" />
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Pilih gaya" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                        <Label Text="Telusuri template gaya rambut yang tersedia." Style="{StaticResource MutedCopy}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="02" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource RoseDark}" VerticalOptions="Start" />
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Atur manual" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                        <Label Text="Geser posisi dan ukuran template secara manual." Style="{StaticResource MutedCopy}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="03" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource RoseDark}" VerticalOptions="Start" />
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Bawa saat konsultasi" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                        <Label Text="Tunjukkan hasil pratinjau kepada stylist saat konsultasi." Style="{StaticResource MutedCopy}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <Label Text="Foto hanya dipakai untuk pratinjau di perangkat ini dan tidak diunggah."
                       Style="{StaticResource MutedCopy}" />
            </Border>
            <Border BackgroundColor="{StaticResource PendingBg}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="14">
                <Label Text="Alat bantu konsultasi visual, bukan AI generation. Hasil hanya template overlay manual."
                       FontSize="12"
                       TextColor="{StaticResource PendingText}" />
            </Border>
            <Button Text="Start Simulation"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnStartClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
