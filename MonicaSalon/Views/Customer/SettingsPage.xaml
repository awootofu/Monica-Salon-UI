<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Customer.SettingsPage"
             Title="Pengaturan"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Preferensi" Style="{StaticResource Eyebrow}" />
            <Label Text="Pengaturan" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Preferensi Umum" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Bahasa Indonesia &amp; IDR" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Switch IsToggled="True" Grid.Column="1" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Notifikasi booking" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Switch IsToggled="True" Grid.Column="1" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Update salon" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Switch IsToggled="False" Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Kontak" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="WhatsApp" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Switch IsToggled="True" Grid.Column="1" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Email" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Switch IsToggled="True" Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Referensi Gaya" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label x:Name="HairstyleStatusLabel" Text="Belum ada gaya favorit dipilih." Style="{StaticResource MutedCopy}" />
                    <Button x:Name="BrowseStyleButton" Text="Lihat Buku Gaya" Style="{StaticResource SecondaryButton}" Clicked="OnBrowseStyles" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Akun" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Button Text="Ubah Kata Sandi" Style="{StaticResource SecondaryButton}" Clicked="OnStub" />
                    <Button Text="Hapus Akun" Style="{StaticResource SecondaryButton}" Clicked="OnStub" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Logout" Style="{StaticResource GhostButton}" Clicked="OnLogout" />
            <Border x:Name="LogoutConfirm" Style="{StaticResource CardFrame}" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Logout dari Monica Salon?" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource DeepCocoa}" HorizontalTextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Logout" Style="{StaticResource PrimaryButton}" FontSize="12" HeightRequest="38" Padding="8,0" Clicked="OnConfirmLogout" />
                        <Button Grid.Column="1" Text="Stay" Style="{StaticResource SecondaryButton}" FontSize="12" HeightRequest="38" Padding="8,0" Clicked="OnStay" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
