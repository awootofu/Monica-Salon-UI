<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Customer.PhotoSelectionPage"
             Title="Pilih Foto"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali"
                    Style="{StaticResource GhostButton}"
                    HorizontalOptions="Start"
                    Clicked="OnBackClicked" />
            <Label Text="Step 1 Photo" Style="{StaticResource Eyebrow}" />
            <Label Text="Pilih Foto" Style="{StaticResource ScreenTitle}" />
            <Label Text="Ambil foto baru atau pilih dari galeri untuk pratinjau manual."
                   Style="{StaticResource BodyCopy}" />
            <Border Style="{StaticResource CardFrame}"
                    Padding="12">
                <Grid HeightRequest="220">
                    <Label x:Name="EmptyLabel"
                           Text="Belum ada foto dipilih."
                           Style="{StaticResource MutedCopy}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Image x:Name="PreviewImage"
                           Source="welcome.jpg"
                           Aspect="AspectFill"
                           IsVisible="False" />
                </Grid>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Take Photo"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnTakePhotoClicked" />
                <Button Grid.Column="1"
                        Text="Choose Gallery"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnChooseGalleryClicked" />
            </Grid>
            <Border Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="10">
                    <CheckBox x:Name="ConsentCheck"
                              CheckedChanged="OnConsentChanged" />
                    <Label Text="Saya setuju foto dipakai untuk pratinjau sementara di perangkat ini."
                           Style="{StaticResource BodyCopy}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Button x:Name="ContinueButton"
                    Text="Continue"
                    Style="{StaticResource PrimaryButton}"
                    IsEnabled="False"
                    Clicked="OnContinueClicked" />
            <Button Text="Cancel"
                    Style="{StaticResource GhostButton}"
                    Clicked="OnCancelClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
