<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:MonicaSalon.Views.Shared"
             x:Class="MonicaSalon.Views.Admin.AdminBookingsPage"
             Title="Booking"
             BackgroundColor="{StaticResource Ivory}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="12">
                <Label Text="Operasional" Style="{StaticResource Eyebrow}" />
                <Label Text="Booking" Style="{StaticResource ScreenTitle}" />
                <SearchBar x:Name="BookingSearch" Placeholder="Cari nama, ref, layanan..." Text="{Binding Query}" />
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Pilih Tanggal" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                      
                        <Border Stroke="#D9CFC4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,4">
                            <DatePicker x:Name="DatePicker"
                                        Date="{Binding FilterDate}"
                                        MinimumDate="{Binding MinDate}"
                                        MaximumDate="{Binding MaxDate}"
                                        FontSize="14"
                                        TextColor="{StaticResource DeepCocoa}"
                                        HeightRequest="48" />
                        </Border>
                        
                    </VerticalStackLayout>
                </Border>
                <shared:SearchableDropdown ItemsSource="{Binding Statuses}"
                                              SelectedItem="{Binding SelectedStatus}"
                                              Placeholder="Pilih status"
                                              SearchPlaceholder="Cari status..." />
                <CollectionView x:Name="BookingsList" ItemsSource="{Binding Bookings}" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardFrame}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Ref}" Style="{StaticResource MutedCopy}" />
                                    <Label Text="{Binding Customer}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                                    <Label Text="{Binding Service}" Style="{StaticResource BodyCopy}" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding Date}" Style="{StaticResource MutedCopy}" />
                                        <Label Text="{Binding Time}" Style="{StaticResource MutedCopy}" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Status}" FontSize="12" TextColor="{StaticResource PendingText}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="+ Booking Baru" Style="{StaticResource PrimaryButton}" Clicked="OnAdd" />
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Padding="8,6" BackgroundColor="White">
            <Button Grid.Column="0" Text="Beranda" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnNavDashboard" />
            <Button Grid.Column="1" Text="Booking" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnNavBookings" />
            <Button Grid.Column="2" Text="Kasir" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnNavCashier" />
            <Button Grid.Column="3" Text="Inventaris" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnNavInventory" />
            <Button Grid.Column="4" Text="Lainnya" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnNavMore" />
        </Grid>
    </Grid>
</ContentPage>
