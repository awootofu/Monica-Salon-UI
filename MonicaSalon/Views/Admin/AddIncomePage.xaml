<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.AddIncomePage"
             Title="Tambah Pemasukan"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Keuangan" Style="{StaticResource Eyebrow}" />
            <Label Text="Tambah Pemasukan" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Tanggal:" Style="{StaticResource MutedCopy}" VerticalOptions="Center" />
                    <Label Text="14 Okt 2026" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Kategori" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="CatOther" Text="Pemasukan Lain" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Column="1" x:Name="CatCapital" Text="Modal Owner" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Column="2" x:Name="CatAdj" Text="Penyesuaian" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nominal (Rp)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Entry x:Name="AmountEntry" Placeholder="cth: 150000" Keyboard="Numeric" Style="{StaticResource FieldEntry}" Text="{Binding AmountText}" />
                    <Label Text="Keterangan (wajib)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Editor x:Name="DescEditor" Placeholder="Jelaskan pemasukan..." HeightRequest="80" BackgroundColor="#FDFBF9" TextColor="{StaticResource Charcoal}" Text="{Binding Description}" />
                    <Label Text="Referensi (opsional)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Entry x:Name="RefEntry" Placeholder="cth: MAN-INC-016" Style="{StaticResource FieldEntry}" Text="{Binding Reference}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}" BackgroundColor="{StaticResource PendingBg}">
                <Label Text="Lengkapi kategori, nominal lebih dari 0, dan keterangan sebelum menyimpan." Style="{StaticResource BodyCopy}" FontSize="12" />
            </Border>
            <Button Text="Simpan Pemasukan" Style="{StaticResource PrimaryButton}" Clicked="OnSave" />
            <Label x:Name="ErrorLabel" Text="{Binding ErrorMessage}" TextColor="{StaticResource DangerText}" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
