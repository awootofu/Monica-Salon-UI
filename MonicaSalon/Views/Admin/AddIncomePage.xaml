<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.AddIncomePage"
             Title="Add Income"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Back" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="A21 • FINANCE" Style="{StaticResource Eyebrow}" />
            <Label Text="Add Income" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Date:" Style="{StaticResource MutedCopy}" VerticalOptions="Center" />
                    <Label Text="14 Okt 2026" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" x:Name="CatOther" Text="Other Income" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Column="1" x:Name="CatCapital" Text="Owner Capital" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Column="2" x:Name="CatAdj" Text="Adjustment" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Amount (Rp)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Entry x:Name="AmountEntry" Placeholder="e.g. 150000" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                    <Label Text="Description (required)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Editor x:Name="DescEditor" Placeholder="Describe the income..." HeightRequest="80" BackgroundColor="#FDFBF9" TextColor="{StaticResource Charcoal}" />
                    <Label Text="Reference (optional)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Entry x:Name="RefEntry" Placeholder="e.g. MAN-INC-016" Style="{StaticResource FieldEntry}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}" BackgroundColor="{StaticResource PendingBg}">
                <Label Text="Guard: category + amount more than 0 + description are required before saving." Style="{StaticResource BodyCopy}" FontSize="12" />
            </Border>
            <Button Text="Save Income" Style="{StaticResource PrimaryButton}" Clicked="OnSave" />
            <Label x:Name="ErrorLabel" Text="" TextColor="{StaticResource DangerText}" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
