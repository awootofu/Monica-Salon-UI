<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.ExportConfigPage"
             Title="Export Config"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Laporan" Style="{StaticResource Eyebrow}" />
            <Label Text="Ekspor Data" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Format" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="XLSX — Excel workbook" Style="{StaticResource BodyCopy}" />
                    <Label x:Name="FileNameLabel" Text="Monica_Salon_Report_2026-10-14.xlsx" Style="{StaticResource MutedCopy}" FontSize="11" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Rentang Tanggal" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label x:Name="RangeLabel" Text="8 Okt–14 Okt 2026" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Dari" Style="{StaticResource MutedCopy}" />
                    <Border Stroke="#D9CFC4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,4">
                        <DatePicker x:Name="StartPicker"
                                    Date="10/08/2026"
                                    MinimumDate="01/01/2026"
                                    MaximumDate="12/31/2026"
                                    DateSelected="OnRangeChanged"
                                    FontSize="14"
                                    TextColor="{StaticResource DeepCocoa}"
                                    HeightRequest="48" />
                    </Border>
                    <Label Text="Sampai" Style="{StaticResource MutedCopy}" />
                    <Border Stroke="#D9CFC4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,4">
                        <DatePicker x:Name="EndPicker"
                                    Date="10/14/2026"
                                    MinimumDate="01/01/2026"
                                    MaximumDate="12/31/2026"
                                    DateSelected="OnRangeChanged"
                                    FontSize="14"
                                    TextColor="{StaticResource DeepCocoa}"
                                    HeightRequest="48" />
                    </Border>
                    <Label Text="Ketuk tanggal untuk membuka kalender." Style="{StaticResource MutedCopy}" FontSize="11" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Datasets" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" RowSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="Kasir" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="CashierSwitch" IsToggled="True" Toggled="OnDatasetToggled" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Financial (required)" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Switch Grid.Row="1" Grid.Column="1" x:Name="FinancialSwitch" IsToggled="True" IsEnabled="False" Toggled="OnDatasetToggled" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Inventory (required)" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Switch Grid.Row="2" Grid.Column="1" x:Name="InventorySwitch" IsToggled="True" IsEnabled="False" Toggled="OnDatasetToggled" />
                        <Label Grid.Row="3" Grid.Column="0" Text="Booking" Style="{StaticResource BodyCopy}" VerticalOptions="Center" />
                        <Switch Grid.Row="3" Grid.Column="1" x:Name="BookingSwitch" IsToggled="False" Toggled="OnDatasetToggled" />
                    </Grid>
                    <Label x:Name="CountLabel" Text="3 datasets selected" Style="{StaticResource MutedCopy}" />
                </VerticalStackLayout>
            </Border>
            <Button x:Name="ExportBtn" Text="Export 3 Datasets" Style="{StaticResource PrimaryButton}" Clicked="OnExport" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
