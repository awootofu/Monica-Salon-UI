<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:MonicaSalon.Views.Shared"
             x:Class="MonicaSalon.Views.Admin.InventoryHistoryPage"
             Title="Movement History"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBackClicked" />
            <Label Text="Inventaris" Style="{StaticResource Eyebrow}" />
            <Label Text="Riwayat Stok" Style="{StaticResource ScreenTitle}" />
            <Label Text="Jejak stock-in, stock-out, dan retail sale." Style="{StaticResource BodyCopy}" />

            <shared:SearchableDropdown ItemsSource="{Binding Types}"
                                          SelectedItem="{Binding SelectedType}"
                                          Placeholder="Pilih tipe"
                                          SearchPlaceholder="Cari tipe..." />

            <CollectionView x:Name="MovementList" ItemsSource="{Binding Movements}">
                <CollectionView.EmptyView>
                    <Label Text="Belum ada pergerakan." Style="{StaticResource MutedCopy}" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardFrame}" Margin="0,4">
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding Qty}" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" FontSize="15" VerticalOptions="Center" />
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,4" VerticalOptions="Center" BackgroundColor="{StaticResource IvoryDeep}">
                                        <Label Text="{Binding Type}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Item}" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" FontSize="14" />
                                <Label Text="{Binding Date}" Style="{StaticResource MutedCopy}" />
                                <Label Text="{Binding Reason}" Style="{StaticResource BodyCopy}" />
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="Related:" Style="{StaticResource MutedCopy}" />
                                    <Label Text="{Binding Related}" Style="{StaticResource MutedCopy}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border Style="{StaticResource CardFrame}">
                <Label Text="Riwayat siap diekspor ke CSV." Style="{StaticResource MutedCopy}" />
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
