<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.SalonProfilePage"
             Title="Salon Profile"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Operasional" Style="{StaticResource Eyebrow}" />
            <Label Text="Profil Salon" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Image Source="monica_salon_interior.jpg" HeightRequest="160" Aspect="AspectFill" />
                    <HorizontalStackLayout Spacing="12" Padding="14">
                        <Border BackgroundColor="{StaticResource DustyRose}" StrokeThickness="0" StrokeShape="RoundRectangle 24" WidthRequest="48" HeightRequest="48" Padding="0" VerticalOptions="Center">
                            <Label Text="M" TextColor="White" FontAttributes="Bold" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2" HorizontalOptions="StartAndExpand">
                            <Label Text="Monica Salon" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" FontSize="16" />
                            <Label Text="Beauty salon since 2015" Style="{StaticResource MutedCopy}" />
                        </VerticalStackLayout>
                        <Button x:Name="EditBtn" Text="Edit" Style="{StaticResource GhostButton}" VerticalOptions="Center" Clicked="OnEdit" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Name" Style="{StaticResource MutedCopy}" />
                    <Entry x:Name="NameEntry" Text="Monica Salon" IsEnabled="False" Style="{StaticResource FieldEntry}" />
                    <Label Text="Address" Style="{StaticResource MutedCopy}" />
                    <Entry x:Name="AddressEntry" Text="Jl. Mawar No. 12, Jakarta" IsEnabled="False" Style="{StaticResource FieldEntry}" />
                    <Label Text="Phone" Style="{StaticResource MutedCopy}" />
                    <Entry x:Name="PhoneEntry" Text="0812-3456-7890" Keyboard="Telephone" IsEnabled="False" Style="{StaticResource FieldEntry}" />
                    <Label Text="Email" Style="{StaticResource MutedCopy}" />
                    <Entry x:Name="EmailEntry" Text="hello@monicasalon.id" Keyboard="Email" IsEnabled="False" Style="{StaticResource FieldEntry}" />
                    <Label Text="Hours" Style="{StaticResource MutedCopy}" />
                    <Entry x:Name="HoursEntry" Text="Mon - Sat 09.00 - 19.00" IsEnabled="False" Style="{StaticResource FieldEntry}" />
                    <Label Text="Note" Style="{StaticResource MutedCopy}" />
                    <Editor x:Name="NoteEditor" Text="Promo Oktober: gratis creambath untuk pewarnaan." IsEnabled="False" HeightRequest="80" BackgroundColor="#FDFBF9" TextColor="{StaticResource Charcoal}" />
                    <Button x:Name="SaveBtn" Text="Save" Style="{StaticResource PrimaryButton}" IsVisible="False" Clicked="OnSave" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
