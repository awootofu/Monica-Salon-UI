<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.AdminBookingDetailsPage"
             Title="Detail Booking"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Detail Booking" Style="{StaticResource ScreenTitle}" />
            <Label Text="MON-261014-028" Style="{StaticResource MutedCopy}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Status" Style="{StaticResource MutedCopy}" />
                    <Border x:Name="StatusBadge" BackgroundColor="{StaticResource PendingBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,4" HorizontalOptions="Start">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Menunggu Konfirmasi">
                                <Setter Property="BackgroundColor" Value="{StaticResource PendingBg}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Dibatalkan">
                                <Setter Property="BackgroundColor" Value="{StaticResource DangerBg}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Dikonfirmasi">
                                <Setter Property="BackgroundColor" Value="{StaticResource SuccessBg}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Selesai">
                                <Setter Property="BackgroundColor" Value="{StaticResource SuccessBg}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label x:Name="StatusLabel" Text="{Binding Status}" TextColor="{StaticResource PendingText}" FontSize="12" FontAttributes="Bold">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Menunggu Konfirmasi">
                                    <Setter Property="TextColor" Value="{StaticResource PendingText}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Dibatalkan">
                                    <Setter Property="TextColor" Value="{StaticResource DangerText}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Dikonfirmasi">
                                    <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Selesai">
                                    <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Label x:Name="CancelNote" Text="Booking dibatalkan." TextColor="{StaticResource DangerText}" FontSize="12" IsVisible="{Binding ShowCancelNote}" />
                    <Button x:Name="ConfirmBtn" Text="Konfirmasi Booking" Style="{StaticResource PrimaryButton}" Clicked="OnConfirm" IsVisible="{Binding ShowConfirm}" />
                    <Button x:Name="CompleteBtn" Text="Tandai Selesai" Style="{StaticResource PrimaryButton}" IsVisible="{Binding ShowComplete}" Clicked="OnComplete" />
                    <Button x:Name="CashierBtn" Text="Lanjut ke Kasir" Style="{StaticResource PrimaryButton}" IsVisible="{Binding ShowCashier}" Clicked="OnCashier" />
                    <Button x:Name="RescheduleBtn" Text="Ubah Jadwal" Style="{StaticResource SecondaryButton}" Clicked="OnReschedule" IsVisible="{Binding ShowReschedule}" />
                    <Button x:Name="CancelBtn" Text="Batalkan Booking" Style="{StaticResource GhostButton}" Clicked="OnCancel" IsVisible="{Binding ShowCancel}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Pelanggan" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Bella Anisa" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="+62 812-3456-7890" Style="{StaticResource BodyCopy}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="12">
                    <Image Source="color.jpg" WidthRequest="64" HeightRequest="64" Aspect="AspectFill" />
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Pewarnaan Rambut" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource DeepCocoa}" />
                        <Label Text="2-3 jam • Coloring" Style="{StaticResource MutedCopy}" />
                        <Label Text="Rp 200.000" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Jadwal &amp; Harga" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Rabu, 14 Oktober 2026 • 11.00 WIB" Style="{StaticResource BodyCopy}" />
                    <Label Text="Estimasi total: Rp 200.000" Style="{StaticResource BodyCopy}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Permintaan Khusus" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Warna cokelat natural, kulit sensitif." Style="{StaticResource BodyCopy}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
