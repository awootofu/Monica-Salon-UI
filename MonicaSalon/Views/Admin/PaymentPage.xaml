<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.PaymentPage"
             Title="Pembayaran"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="← Back" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Langkah 2 dari 2" Style="{StaticResource Eyebrow}" />
            <Label Text="Pembayaran" Style="{StaticResource ScreenTitle}" />

            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="TRX-261014-083" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Bella Anisa • 14 Okt 14.42" Style="{StaticResource BodyCopy}" />
                    <Label Text="Total Rp 279.000" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource DeepCocoa}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Metode pembayaran" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource DeepCocoa}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button x:Name="CashBtn" Grid.Column="0" Text="Cash" Style="{StaticResource PrimaryButton}" HeightRequest="44" FontSize="12" Clicked="OnMethodSelected" />
                <Button x:Name="QrisBtn" Grid.Column="1" Text="QRIS" Style="{StaticResource SecondaryButton}" HeightRequest="44" FontSize="12" Clicked="OnMethodSelected" />
            </Grid>

            <VerticalStackLayout x:Name="CashBox" Spacing="8" IsVisible="{Binding IsCash}">
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Nominal diterima" Style="{StaticResource MutedCopy}" />
                        <Entry x:Name="CashEntry" Placeholder="cth 300000" Keyboard="Numeric" Style="{StaticResource FieldEntry}" Text="{Binding CashText}" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="279rb" FontSize="11" HeightRequest="40" Style="{StaticResource SecondaryButton}" CommandParameter="279000" Clicked="OnQuickCash" />
                            <Button Grid.Column="1" Text="300rb" FontSize="11" HeightRequest="40" Style="{StaticResource SecondaryButton}" CommandParameter="300000" Clicked="OnQuickCash" />
                            <Button Grid.Column="2" Text="350rb" FontSize="11" HeightRequest="40" Style="{StaticResource SecondaryButton}" CommandParameter="350000" Clicked="OnQuickCash" />
                            <Button Grid.Column="3" Text="500rb" FontSize="11" HeightRequest="40" Style="{StaticResource SecondaryButton}" CommandParameter="500000" Clicked="OnQuickCash" />
                        </Grid>
                        <Label x:Name="CashStatusLabel" Text="{Binding CashStatusText}" Style="{StaticResource MutedCopy}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="RefBox" Spacing="8" IsVisible="{Binding IsNonCash}">
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="No. referensi / ID transaksi" Style="{StaticResource MutedCopy}" />
                        <Entry x:Name="RefEntry" Placeholder="cth TRF-2026-0001" Style="{StaticResource FieldEntry}" Text="{Binding ReferenceText}" />
                        <Label Text="Pembayaran diverifikasi via gateway sebelum menyimpan." Style="{StaticResource MutedCopy}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <Button x:Name="PayBtn" Text="Selesaikan Pembayaran" Style="{StaticResource PrimaryButton}" Clicked="OnComplete" IsEnabled="{Binding CanPay}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
