<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.TransactionReviewPage"
             Title="Review Transaction"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="← Back" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Langkah 1 dari 2" Style="{StaticResource Eyebrow}" />
            <Label Text="Tinjau Transaksi" Style="{StaticResource ScreenTitle}" />

            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Customer" Style="{StaticResource MutedCopy}" />
                    <Label Text="Bella Anisa" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="MON-261014-028 • 14 Okt 11.00" Style="{StaticResource BodyCopy}" />
                </VerticalStackLayout>
            </Border>

            <CollectionView x:Name="ItemsList" SelectionMode="None" ItemsSource="{Binding Lines}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardFrame}" Margin="0,4">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                                <Label Text="{Binding PriceText}" Style="{StaticResource MutedCopy}" />
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Button Text="-" WidthRequest="40" HeightRequest="40" Style="{StaticResource SecondaryButton}" Clicked="OnMinus" CommandParameter="{Binding Id}" />
                                    <Label Text="{Binding Qty}" VerticalOptions="Center" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Charcoal}" />
                                    <Button Text="+" WidthRequest="40" HeightRequest="40" Style="{StaticResource SecondaryButton}" Clicked="OnPlus" CommandParameter="{Binding Id}" />
                                    <Button Text="Hapus" FontSize="11" HeightRequest="40" Style="{StaticResource SecondaryButton}" Clicked="OnTrash" CommandParameter="{Binding Id}" />
                                    <Label Text="{Binding LineTotalText}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource DeepCocoa}" VerticalOptions="Center" HorizontalOptions="EndAndExpand" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label x:Name="EmptyLabel" Text="Semua item dihapus. Kembali untuk tambah item." Style="{StaticResource MutedCopy}" IsVisible="{Binding IsEmpty}" />

            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Subtotal layanan" Style="{StaticResource BodyCopy}" />
                        <Label Grid.Column="1" x:Name="ServiceSubtotalLabel" Text="{Binding ServiceSubtotalText}" Style="{StaticResource BodyCopy}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Subtotal produk" Style="{StaticResource BodyCopy}" />
                        <Label Grid.Column="1" x:Name="ProductSubtotalLabel" Text="{Binding ProductSubtotalText}" Style="{StaticResource BodyCopy}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Diskon" Style="{StaticResource BodyCopy}" />
                        <Label Grid.Column="1" Text="Rp 0" Style="{StaticResource BodyCopy}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Grand total" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                        <Label Grid.Column="1" x:Name="GrandTotalLabel" Text="{Binding GrandTotalText}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Catatan: pembayaran mencatat FIN otomatis dan mengurangi stok." Style="{StaticResource MutedCopy}" />
            <Button x:Name="ContinueBtn" Text="Lanjut ke Pembayaran" Style="{StaticResource PrimaryButton}" Clicked="OnContinue" IsEnabled="{Binding CanContinue}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
