<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.AdminReschedulePage"
             Title="Reschedule"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Ubah Jadwal" Style="{StaticResource Eyebrow}" />
            <Label Text="Ubah Jadwal" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Jadwal Saat Ini" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="MON-261014-028" Style="{StaticResource MutedCopy}" />
                    <Label Text="Rabu, 14 Okt 2026 • 11.00 WIB" Style="{StaticResource BodyCopy}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tanggal Baru" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="{Binding SelectedDateText}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource DeepCocoa}" />
                    <Border Stroke="#D9CFC4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,4">
                        <DatePicker x:Name="DatePicker"
                                    Date="{Binding SelectedDate}"
                                    MinimumDate="{Binding MinDate}"
                                    MaximumDate="{Binding MaxDate}"
                                    DateSelected="OnDateSelected"
                                    FontSize="14"
                                    TextColor="{StaticResource DeepCocoa}"
                                    HeightRequest="48" />
                    </Border>
                    <Label Text="Ketuk tanggal untuk membuka kalender." Style="{StaticResource MutedCopy}" FontSize="11" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Jam Baru" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn0900" Text="09.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" CommandParameter="09.00">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedTime}" Value="09.00">
                                    <Setter Property="BackgroundColor" Value="{StaticResource DustyRose}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1000" Text="10.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" CommandParameter="10.00">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedTime}" Value="10.00">
                                    <Setter Property="BackgroundColor" Value="{StaticResource DustyRose}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1130" Text="11.30" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" CommandParameter="11.30">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedTime}" Value="11.30">
                                    <Setter Property="BackgroundColor" Value="{StaticResource DustyRose}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1300" Text="13.00 penuh" IsEnabled="False" WidthRequest="100" HeightRequest="44" FontSize="12" Margin="0,0,6,6" />
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1400" Text="14.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" CommandParameter="14.00">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedTime}" Value="14.00">
                                    <Setter Property="BackgroundColor" Value="{StaticResource DustyRose}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Style="{StaticResource SlotButton}" x:Name="TimeBtn1600" Text="16.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnTimeSelected" CommandParameter="16.00">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding SelectedTime}" Value="16.00">
                                    <Setter Property="BackgroundColor" Value="{StaticResource DustyRose}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </FlexLayout>
                    <Label x:Name="ConflictLabel" Text="{Binding ConflictText}" Style="{StaticResource MutedCopy}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsConflict}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource DangerText}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsReady}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource SuccessText}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>
            <Button x:Name="SaveBtn" Text="Simpan Perubahan" Style="{StaticResource PrimaryButton}" Clicked="OnSave" IsEnabled="{Binding CanSave}" />
            <Border x:Name="SuccessBox" Style="{StaticResource CardFrame}" IsVisible="{Binding IsSaved}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Jadwal berhasil diubah." FontAttributes="Bold" FontSize="14" TextColor="{StaticResource SuccessText}" />
                    <Button Text="Kembali ke Detail" Style="{StaticResource SecondaryButton}" Clicked="OnBackToDetail" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
