<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.AdminCreateBookingPage"
             Title="Buat Booking"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Booking Baru" Style="{StaticResource Eyebrow}" />
            <Label Text="Buat Booking" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Pelanggan" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Button Style="{StaticResource SlotButton}" x:Name="CustomerBtnSiti" Text="Siti Anisa" FontSize="13" HeightRequest="46" Clicked="OnCustomerSelected" />
                    <Button Style="{StaticResource SlotButton}" x:Name="CustomerBtnRachel" Text="Rachel Putri" FontSize="13" HeightRequest="46" Clicked="OnCustomerSelected" />
                    <Button Style="{StaticResource SlotButton}" x:Name="CustomerBtnNew" Text="Pelanggan baru" FontSize="13" HeightRequest="46" Clicked="OnCustomerSelected" />
                    <VerticalStackLayout x:Name="NewCustomerFields" Spacing="8" IsVisible="False">
                        <Label Text="Nama pelanggan" Style="{StaticResource MutedCopy}" />
                        <Entry x:Name="NewNameEntry" Placeholder="Nama lengkap" />
                        <Label Text="No. HP" Style="{StaticResource MutedCopy}" />
                        <Entry x:Name="NewPhoneEntry" Placeholder="+62 8xx-xxxx-xxxx" Keyboard="Telephone" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Layanan" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Button Style="{StaticResource SlotButton}" x:Name="ServiceBtnCut" Text="Potong Rambut • Rp 50.000" FontSize="13" HeightRequest="46" Clicked="OnServiceSelected" />
                    <Button Style="{StaticResource SlotButton}" x:Name="ServiceBtnCream" Text="Creambath • Rp 80.000" FontSize="13" HeightRequest="46" Clicked="OnServiceSelected" />
                    <Button Style="{StaticResource SlotButton}" x:Name="ServiceBtnColor" Text="Pewarnaan Rambut • Rp 200.000" FontSize="13" HeightRequest="46" Clicked="OnServiceSelected" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Jadwal" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Rabu, 14 Oktober 2026" Style="{StaticResource MutedCopy}" />
                    <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start" AlignItems="Start">
                        <Button Style="{StaticResource SlotButton}" x:Name="Slot0900" Text="09.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnSlotSelected" />
                        <Button Style="{StaticResource SlotButton}" x:Name="Slot1000" Text="10.00 penuh" IsEnabled="False" WidthRequest="100" HeightRequest="44" FontSize="12" Margin="0,0,6,6" />
                        <Button Style="{StaticResource SlotButton}" x:Name="Slot1130" Text="11.30" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnSlotSelected" />
                        <Button Style="{StaticResource SlotButton}" x:Name="Slot1300" Text="13.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnSlotSelected" />
                        <Button Style="{StaticResource SlotButton}" x:Name="Slot1400" Text="14.00 penuh" IsEnabled="False" WidthRequest="100" HeightRequest="44" FontSize="12" Margin="0,0,6,6" />
                        <Button Style="{StaticResource SlotButton}" x:Name="Slot1600" Text="16.00" WidthRequest="76" HeightRequest="44" FontSize="12" Margin="0,0,6,6" Clicked="OnSlotSelected" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Catatan" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Editor x:Name="NotesEditor" Placeholder="Contoh: pelanggan sensitif pewarna..." AutoSize="TextChanges" />
                </VerticalStackLayout>
            </Border>
            <Label x:Name="SummaryLabel" Text="Pilih pelanggan, layanan, dan jam dahulu." Style="{StaticResource MutedCopy}" />
            <Button Text="Simpan Booking" Style="{StaticResource PrimaryButton}" Clicked="OnSave" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
