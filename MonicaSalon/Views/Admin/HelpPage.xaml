<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.HelpPage"
             Title="Bantuan"
             BackgroundColor="{StaticResource Ivory}">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="12">
                <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
                <Label Text="Bantuan" Style="{StaticResource Eyebrow}" />
                <Label Text="Bantuan" Style="{StaticResource ScreenTitle}" />
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Button Text="Panduan Booking" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnToggleBooking" />
                        <Label x:Name="BookingBody" Text="Buat, konfirmasi, ubah jadwal, dan batalkan booking dari menu Booking." Style="{StaticResource BodyCopy}" FontSize="12" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Button Text="Panduan Kasir" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnToggleCashier" />
                        <Label x:Name="CashierBody" Text="Tambahkan layanan dan produk ke keranjang, periksa transaksi, lalu terima pembayaran." Style="{StaticResource BodyCopy}" FontSize="12" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Button Text="Panduan Stok" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnToggleInventory" />
                        <Label x:Name="InventoryBody" Text="Pantau stok retail dan material, catat stok masuk dan stok keluar." Style="{StaticResource BodyCopy}" FontSize="12" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Button Text="Panduan Ekspor" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnToggleExport" />
                        <Label x:Name="ExportBody" Text="Pilih data dan rentang tanggal di menu Ekspor, lalu unduh file Excel." Style="{StaticResource BodyCopy}" FontSize="12" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Dukungan" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                        <Label Text="Mon - Sat 09.00 - 19.00 • hello@monicasalon.id • 0812-3456-7890" Style="{StaticResource BodyCopy}" FontSize="12" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Akun" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                        <Button Text="Logout" Style="{StaticResource SecondaryButton}" Clicked="OnLogout" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border x:Name="LogoutConfirm" IsVisible="False" BackgroundColor="#80000000" StrokeThickness="0" Padding="20" VerticalOptions="Fill" HorizontalOptions="Fill">
            <Border Style="{StaticResource CardFrame}" VerticalOptions="Center">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Keluar?" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" FontSize="16" />
                    <Label Text="Kamu akan kembali ke layar masuk admin." Style="{StaticResource BodyCopy}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Logout" Style="{StaticResource PrimaryButton}" Clicked="OnConfirmLogout" />
                        <Button Grid.Column="1" Text="Batal" Style="{StaticResource SecondaryButton}" Clicked="OnCancelLogout" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Border>
    </Grid>
</ContentPage>
