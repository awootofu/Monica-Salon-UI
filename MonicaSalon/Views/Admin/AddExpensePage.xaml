<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.AddExpensePage"
             Title="Add Expense"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Back" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="A22 • FINANCE" Style="{StaticResource Eyebrow}" />
            <Label Text="Add Expense" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Date:" Style="{StaticResource MutedCopy}" VerticalOptions="Center" />
                    <Label Text="14 Okt 2026" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Category" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0" x:Name="CatInv" Text="Inventory Purchase" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Row="0" Grid.Column="1" x:Name="CatUtil" Text="Utilities" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Row="1" Grid.Column="0" x:Name="CatOps" Text="Operations" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Row="1" Grid.Column="1" x:Name="CatPay" Text="Payroll" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Amount (Rp)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Entry x:Name="AmountEntry" Placeholder="e.g. 180000" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                    <Label Text="Description (required)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Editor x:Name="DescEditor" Placeholder="Describe the expense..." HeightRequest="80" BackgroundColor="#FDFBF9" TextColor="{StaticResource Charcoal}" />
                    <Label Text="Reference (optional)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Entry x:Name="RefEntry" Placeholder="e.g. MAN-EXP-044" Style="{StaticResource FieldEntry}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}" BackgroundColor="{StaticResource PendingBg}">
                <Label Text="Guard: category + amount more than 0 + description are required before saving." Style="{StaticResource BodyCopy}" FontSize="12" />
            </Border>
            <Button Text="Save Expense" Style="{StaticResource PrimaryButton}" Clicked="OnSave" />
            <Label x:Name="ErrorLabel" Text="" TextColor="{StaticResource DangerText}" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
