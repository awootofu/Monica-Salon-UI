<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.AddExpensePage"
             Title="Tambah Pengeluaran"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Keuangan" Style="{StaticResource Eyebrow}" />
            <Label Text="Tambah Pengeluaran" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tanggal" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label x:Name="DateLabel" Text="14 Okt 2026" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Border Stroke="#D9CFC4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,4">
                        <DatePicker x:Name="DatePicker"
                                    Date="10/14/2026"
                                    MinimumDate="01/01/2026"
                                    MaximumDate="12/31/2026"
                                    DateSelected="OnDateChanged"
                                    FontSize="14"
                                    TextColor="{StaticResource DeepCocoa}"
                                    HeightRequest="48" />
                    </Border>
                    <Label Text="Ketuk tanggal untuk membuka kalender." Style="{StaticResource MutedCopy}" FontSize="11" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Kategori" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Button Grid.Row="0" Grid.Column="0" x:Name="CatInv" Text="Belanja Stok" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Row="0" Grid.Column="1" x:Name="CatUtil" Text="Utilitas" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Row="1" Grid.Column="0" x:Name="CatOps" Text="Operasional" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                        <Button Grid.Row="1" Grid.Column="1" x:Name="CatPay" Text="Gaji" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnCategory" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nominal (Rp)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Entry x:Name="AmountEntry" Placeholder="cth: 180000" Keyboard="Numeric" Style="{StaticResource FieldEntry}" Text="{Binding AmountText}" />
                    <Label Text="Keterangan (wajib)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Editor x:Name="DescEditor" Placeholder="Jelaskan pengeluaran..." HeightRequest="80" BackgroundColor="#FDFBF9" TextColor="{StaticResource Charcoal}" Text="{Binding Description}" />
                    <Label Text="Referensi (opsional)" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <Entry x:Name="RefEntry" Placeholder="cth: MAN-EXP-044" Style="{StaticResource FieldEntry}" Text="{Binding Reference}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}" BackgroundColor="{StaticResource PendingBg}">
                <Label Text="Lengkapi kategori, nominal lebih dari 0, dan keterangan sebelum menyimpan." Style="{StaticResource BodyCopy}" FontSize="12" />
            </Border>
            <Button Text="Simpan Pengeluaran" Style="{StaticResource PrimaryButton}" Clicked="OnSave" />
            <Label x:Name="ErrorLabel" Text="{Binding ErrorMessage}" TextColor="{StaticResource DangerText}" FontSize="12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
