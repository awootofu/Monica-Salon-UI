<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:MonicaSalon.Views.Shared"
             x:Class="MonicaSalon.Views.Admin.FinancialRecordsPage"
             Title="Financial Records"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Keuangan" Style="{StaticResource Eyebrow}" />
            <Label Text="Catatan Keuangan" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Rentang Tanggal" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label x:Name="RangeLabel" Text="8 Okt–14 Okt 2026" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource DeepCocoa}" />
                    <Label Text="Dari" Style="{StaticResource MutedCopy}" />
                    <Border Stroke="#D9CFC4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,4">
                        <DatePicker x:Name="StartPicker"
                                    Date="10/08/2026"
                                    MinimumDate="01/01/2026"
                                    MaximumDate="12/31/2026"
                                    DateSelected="OnRangeChanged"
                                    FontSize="14"
                                    TextColor="{StaticResource DeepCocoa}"
                                    HeightRequest="48" />
                    </Border>
                    <Label Text="Sampai" Style="{StaticResource MutedCopy}" />
                    <Border Stroke="#D9CFC4" StrokeThickness="1" StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="12,4">
                        <DatePicker x:Name="EndPicker"
                                    Date="10/14/2026"
                                    MinimumDate="01/01/2026"
                                    MaximumDate="12/31/2026"
                                    DateSelected="OnRangeChanged"
                                    FontSize="14"
                                    TextColor="{StaticResource DeepCocoa}"
                                    HeightRequest="48" />
                    </Border>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Kategori" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" FontSize="12" />
                    <shared:SearchableDropdown ItemsSource="{Binding Categories}"
                                                      SelectedItem="{Binding SelectedCategory}"
                                                      Placeholder="Pilih kategori"
                                                      SearchPlaceholder="Cari kategori..." />
                    <Label Text="Type" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" FontSize="12" />
                    <shared:SearchableDropdown ItemsSource="{Binding Types}"
                                                  SelectedItem="{Binding SelectedType}"
                                                  Placeholder="Pilih tipe"
                                                  SearchPlaceholder="Cari tipe..." />
                </VerticalStackLayout>
            </Border>
            <CollectionView x:Name="RecordsList" ItemsSource="{Binding Records}" SelectionMode="Single" SelectionChanged="OnRecordSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardFrame}" Margin="0,4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Date}" Style="{StaticResource MutedCopy}" FontSize="11" />
                                    <Label Text="{Binding Category}" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource RoseDark}" />
                                    <Label Text="{Binding Description}" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" FontSize="13" />
                                    <Label Text="{Binding Reference}" Style="{StaticResource MutedCopy}" FontSize="11" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="{Binding DisplayAmount}" FontAttributes="Bold" FontSize="13" VerticalOptions="Center" TextColor="{StaticResource Charcoal}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
