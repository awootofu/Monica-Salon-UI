<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.AdminMorePage"
             Title="Lainnya"
             BackgroundColor="{StaticResource Ivory}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="12">
                <Label Text="Menu Owner" Style="{StaticResource Eyebrow}" />
                <Label Text="Lainnya" Style="{StaticResource ScreenTitle}" />
                <Border Style="{StaticResource CardFrame}">
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="{StaticResource DustyRose}" StrokeThickness="0" StrokeShape="RoundRectangle 24" WidthRequest="48" HeightRequest="48" Padding="0" VerticalOptions="Center">
                            <Label Text="MA" TextColor="White" FontAttributes="Bold" FontSize="16" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                            <Label Text="Monica Admin" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" FontSize="15" />
                            <Label Text="Owner • monica@salon.id" Style="{StaticResource MutedCopy}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
                <Label Text="Katalog" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Button Text="Kelola Layanan" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnServices" />
                        <BoxView HeightRequest="1" Color="#E7DDD6" />
                        <Button Text="Kelola Produk" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnProducts" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="Operasional" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Button Text="Pengaturan Salon" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnSalonSettings" />
                        <BoxView HeightRequest="1" Color="#E7DDD6" />
                        <Button Text="Kelola Pengguna" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnUsers" />
                        <BoxView HeightRequest="1" Color="#E7DDD6" />
                        <Button Text="Profil Salon" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnSalonProfile" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="Laporan" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                <Border Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="4">
                        <Button Text="Keuangan" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnFinance" />
                        <BoxView HeightRequest="1" Color="#E7DDD6" />
                        <Button Text="Ekspor Data" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnExport" />
                        <BoxView HeightRequest="1" Color="#E7DDD6" />
                        <Button Text="Bantuan" Style="{StaticResource GhostButton}" HorizontalOptions="Fill" Clicked="OnHelp" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Logout" Style="{StaticResource GhostButton}" Clicked="OnLogout" />
                <Border x:Name="LogoutConfirm" Style="{StaticResource CardFrame}" IsVisible="False">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Logout dari Monica Salon?" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource DeepCocoa}" HorizontalTextAlignment="Center" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Text="Logout" Style="{StaticResource PrimaryButton}" FontSize="12" HeightRequest="38" Padding="8,0" Clicked="OnConfirmLogout" />
                            <Button Grid.Column="1" Text="Batal" Style="{StaticResource SecondaryButton}" FontSize="12" HeightRequest="38" Padding="8,0" Clicked="OnCancelLogout" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Padding="8,6" BackgroundColor="White">
            <Button Grid.Column="0" Text="Beranda" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnNavDashboard" />
            <Button Grid.Column="1" Text="Booking" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnNavBookings" />
            <Button Grid.Column="2" Text="Kasir" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnNavCashier" />
            <Button Grid.Column="3" Text="Inventaris" Style="{StaticResource GhostButton}" FontSize="11" Clicked="OnNavInventory" />
            <Button Grid.Column="4" Text="Lainnya" FontSize="11" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{StaticResource DeepCocoa}" Clicked="OnNavMore" />
        </Grid>
    </Grid>
</ContentPage>
