<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MonicaSalon.Views.Admin.ExportResultPage"
             Title="Hasil Ekspor"
             BackgroundColor="{StaticResource Ivory}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Button Text="‹ Kembali" Style="{StaticResource GhostButton}" HorizontalOptions="Start" Clicked="OnBack" />
            <Label Text="Laporan" Style="{StaticResource Eyebrow}" />
            <Label Text="Hasil Ekspor" Style="{StaticResource ScreenTitle}" />
            <Border Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Status Ekspor" FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" FontSize="12" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Proses" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnShowProgress" />
                        <Button Grid.Column="1" Text="Berhasil" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnShowSuccess" />
                        <Button Grid.Column="2" Text="Gagal" Style="{StaticResource SecondaryButton}" FontSize="11" HeightRequest="44" Clicked="OnShowFailure" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border x:Name="ProgressLayout" Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mengekspor..." FontAttributes="Bold" TextColor="{StaticResource DeepCocoa}" />
                    <BoxView Color="{StaticResource IvoryDeep}" HeightRequest="10" CornerRadius="5" />
                    <BoxView Color="{StaticResource DustyRose}" HeightRequest="10" WidthRequest="160" CornerRadius="5" HorizontalOptions="Start" />
                    <Label Text="Menyiapkan data, mohon tunggu." Style="{StaticResource MutedCopy}" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="SuccessLayout" Style="{StaticResource CardFrame}" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Border BackgroundColor="{StaticResource SuccessBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,4" HorizontalOptions="Start">
                        <Label Text="Berhasil" TextColor="{StaticResource SuccessText}" FontSize="11" FontAttributes="Bold" />
                    </Border>
                    <Label Text="Monica_Salon_Report_2026-10-14.xlsx" FontAttributes="Bold" TextColor="{StaticResource Charcoal}" />
                    <Label Text="3 datasets • 8-14 Okt 2026" Style="{StaticResource MutedCopy}" />
                    <Button Text="Unduh" Style="{StaticResource PrimaryButton}" Clicked="OnDownload" />
                    <Button Text="Kembali ke Ringkasan" Style="{StaticResource SecondaryButton}" Clicked="OnBackToOverview" />
                </VerticalStackLayout>
            </Border>
            <Border x:Name="FailureLayout" Style="{StaticResource CardFrame}" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Border BackgroundColor="{StaticResource DangerBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,4" HorizontalOptions="Start">
                        <Label Text="Gagal" TextColor="{StaticResource DangerText}" FontSize="11" FontAttributes="Bold" />
                    </Border>
                    <Label Text="Ekspor gagal. Periksa koneksi lalu coba lagi." Style="{StaticResource BodyCopy}" />
                    <Button Text="Coba Lagi" Style="{StaticResource PrimaryButton}" Clicked="OnRetry" />
                    <Button Text="Ubah Pengaturan" Style="{StaticResource SecondaryButton}" Clicked="OnReviewConfig" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
