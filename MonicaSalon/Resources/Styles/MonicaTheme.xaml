<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Monica Salon palette (from index.css :root) -->
    <Color x:Key="Ivory">#F7F0E8</Color>
    <Color x:Key="IvoryDeep">#EEE2D6</Color>
    <Color x:Key="SoftBlush">#E8B9B1</Color>
    <Color x:Key="DustyRose">#C87570</Color>
    <Color x:Key="RoseDark">#AF5F5B</Color>
    <Color x:Key="DeepCocoa">#75463B</Color>
    <Color x:Key="Sage">#667D6B</Color>
    <Color x:Key="MutedAmber">#D9A04F</Color>
    <Color x:Key="Charcoal">#38332F</Color>
    <Color x:Key="Muted">#8F8179</Color>
    <Color x:Key="CardWhite">#FFFFFF</Color>
    <Color x:Key="SuccessBg">#E4EFE6</Color>
    <Color x:Key="SuccessText">#4F7157</Color>
    <Color x:Key="PendingBg">#FFF0D7</Color>
    <Color x:Key="PendingText">#A56D1C</Color>
    <Color x:Key="DangerBg">#F7E3E1</Color>
    <Color x:Key="DangerText">#A65854</Color>

    <Style x:Key="ScreenTitle" TargetType="Label">
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource DeepCocoa}" />
    </Style>
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource RoseDark}" />
        <Setter Property="CharacterSpacing" Value="0.6" />
    </Style>
    <Style x:Key="BodyCopy" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource Charcoal}" />
    </Style>
    <Style x:Key="MutedCopy" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource DustyRose}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource DeepCocoa}" />
        <Setter Property="BorderColor" Value="#D9CFC4" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource RoseDark}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="SlotButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource DeepCocoa}" />
        <Setter Property="BorderColor" Value="#D9CFC4" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="CardFrame" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="#E7DDD6" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="FieldEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="#FDFBF9" />
        <Setter Property="TextColor" Value="{StaticResource Charcoal}" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="FontSize" Value="14" />
    </Style>
</ResourceDictionary>
